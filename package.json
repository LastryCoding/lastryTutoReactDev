{
  "name": "react-quest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "scripts": {
    "build": "pnpm validate:content && pnpm validate:exercises && cross-env ASTRO_TELEMETRY_DISABLED=1 astro check && cross-env ASTRO_TELEMETRY_DISABLED=1 astro build",
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "start": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check",
    "validate:content": "tsx scripts/validate-content.ts",
    "validate:exercises": "tsx scripts/validate-exercises.ts"
  },
  "dependencies": {
    "@tutorialkit/react": "1.6.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/react": "3.6.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@tutorialkit/astro": "1.6.0",
    "@tutorialkit/theme": "1.6.0",
    "@tutorialkit/types": "1.6.0",
    "@unocss/reset": "0.62.4",
    "@types/node": "22.20.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "astro": "4.16.19",
    "cross-env": "10.1.0",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "globals": "17.12.0",
    "happy-dom": "20.12.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "5.4.21",
    "vitest": "3.2.7"
  }
}
